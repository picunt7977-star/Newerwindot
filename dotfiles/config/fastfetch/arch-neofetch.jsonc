// Пресет neofetch, но всё показывается как Arch Linux (для приветствия fish)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "size": {
            "maxPrefix": "MB",
            "ndigits": 0,
            "spaceBeforeUnit": "never"
        },
        "freq": {
            "ndigits": 3,
            "spaceBeforeUnit": "never"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{#1;32}archlinux"
        },
        {
            "type": "custom",
            "format": "--------------"
        },
        {
            "type": "os",
            "format": "Arch Linux {arch}"
        },
        "host",
        {
            "type": "board",
            "key": "Host",
            "condition": {
                "succeeded": false
            }
        },
        {
            "type": "command",
            "key": "Kernel",
            "text": "uname -r | sed -E 's/-([0-9]+)-cachyos.*/-arch1-\\1/; s/cachyos/arch/g'"
        },
        "uptime",
        {
            "type": "packages",
            "combined": true
        },
        "shell",
        {
            "type": "display",
            "compactType": "original",
            "key": "Resolution"
        },
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "terminal",
        {
            "type": "terminalfont",
            "format": "{/name}{-}{/}{name}{?size} {size}{?}"
        },
        "cpu",
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        "break",
        "colors"
    ]
}
